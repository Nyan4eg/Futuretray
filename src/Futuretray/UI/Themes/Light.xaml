<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Text" Color="#E4000000"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9E000000"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#72000000"/>

    <SolidColorBrush x:Key="Brush.WindowFallback" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="Brush.Layer" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Brush.LayerSolid" Color="#FFF9F9F9"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardStroke" Color="#12000000"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#0F000000"/>

    <SolidColorBrush x:Key="Brush.Control" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="Brush.ControlFocused" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlStroke" Color="#1A000000"/>
    <SolidColorBrush x:Key="Brush.ControlStrong" Color="#72000000"/>
    <SolidColorBrush x:Key="Brush.ControlTrack" Color="#30000000"/>

    <SolidColorBrush x:Key="Brush.SubtleHover" Color="#09000000"/>
    <SolidColorBrush x:Key="Brush.SubtlePressed" Color="#06000000"/>
    <SolidColorBrush x:Key="Brush.SubtleSelected" Color="#0D000000"/>

    <SolidColorBrush x:Key="Brush.TileHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="Brush.TilePressed" Color="#08000000"/>

    <SolidColorBrush x:Key="Brush.Flyout" Color="#FFF9F9F9"/>
    <SolidColorBrush x:Key="Brush.FlyoutStroke" Color="#1A000000"/>
    <SolidColorBrush x:Key="Brush.Dialog" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.DialogFooter" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="Brush.Smoke" Color="#4D000000"/>

    <SolidColorBrush x:Key="Brush.PopupSolid" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="Brush.PopupPreview" Color="#E6F8F8F8"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#50000000"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#1AC42B1C"/>
    <SolidColorBrush x:Key="Brush.Segment" Color="#08000000"/>
    <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Taskbar" Color="#E6F3F3F3"/>

    <LinearGradientBrush x:Key="Brush.Wallpaper" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFBFD7FF" Offset="0"/>
        <GradientStop Color="#FFD9C8FF" Offset="0.5"/>
        <GradientStop Color="#FFA8E6F0" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
