<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8AFFFFFF"/>

    <SolidColorBrush x:Key="Brush.WindowFallback" Color="#FF202020"/>
    <SolidColorBrush x:Key="Brush.Layer" Color="#4C3A3A3A"/>
    <SolidColorBrush x:Key="Brush.LayerSolid" Color="#FF282828"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardStroke" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#15FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Control" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlFocused" Color="#B31E1E1E"/>
    <SolidColorBrush x:Key="Brush.ControlStroke" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlStrong" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlTrack" Color="#40FFFFFF"/>

    <SolidColorBrush x:Key="Brush.SubtleHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.SubtlePressed" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.SubtleSelected" Color="#14FFFFFF"/>

    <SolidColorBrush x:Key="Brush.TileHover" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="Brush.TilePressed" Color="#10FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Flyout" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="Brush.FlyoutStroke" Color="#33000000"/>
    <SolidColorBrush x:Key="Brush.Dialog" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="Brush.DialogFooter" Color="#FF202020"/>
    <SolidColorBrush x:Key="Brush.Smoke" Color="#80000000"/>

    <SolidColorBrush x:Key="Brush.PopupSolid" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="Brush.PopupPreview" Color="#D9282828"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#60FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF99A4"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#26FF99A4"/>
    <SolidColorBrush x:Key="Brush.Segment" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Taskbar" Color="#E01C1C1C"/>

    <LinearGradientBrush x:Key="Brush.Wallpaper" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1B1F3B" Offset="0"/>
        <GradientStop Color="#FF3B2A6B" Offset="0.5"/>
        <GradientStop Color="#FF0F4C75" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
