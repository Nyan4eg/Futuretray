<Window x:Class="Futuretray.UI.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Futuretray.UI"
        Title="Futuretray — поиск"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True" Width="620" Height="120"
        Background="Transparent"
        Foreground="{DynamicResource Brush.Text}" FontFamily="{StaticResource Font.Text}" FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="Ph" Text="{TemplateBinding ui:Ui.Placeholder}" Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="2,0" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="10,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TileHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="SolidLayer" Background="{DynamicResource Brush.PopupSolid}" Visibility="Collapsed"/>

        <StackPanel x:Name="Body" Margin="8" VerticalAlignment="Top">
            <Grid Margin="8,4,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" Style="{StaticResource Text.Glyph}" FontSize="18" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0"/>
                <TextBox x:Name="Query" Grid.Column="1" Style="{StaticResource SearchBox}" Padding="0,4"
                         ui:Ui.Placeholder="Найти программу в группах…" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="-8,0,-8,6"/>

            <ListBox x:Name="Results" MaxHeight="430" ItemContainerStyle="{StaticResource ResultItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                     MouseLeftButtonUp="Results_MouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="3" CornerRadius="1.5" Margin="0,0,10,0" Background="{DynamicResource Brush.TextSecondary}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolVisible}}" ToolTip="Программа открыта"/>
                                <Image Source="{Binding GroupIcon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding GroupName}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Text="Ничего не найдено" Margin="12,10,12,14" Visibility="Collapsed"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="12,6,12,2" TextWrapping="NoWrap"
                       Text="Enter — открыть  ·  Shift+Enter — новая копия  ·  ↑↓ — выбор  ·  Esc — закрыть"/>
        </StackPanel>
    </Grid>
</Window>
