<Window x:Class="Futuretray.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Futuretray.UI"
        xmlns:core="clr-namespace:Futuretray.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Futuretray" Width="1140" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Futuretray;component/Assets/app.ico"
        Background="{DynamicResource Brush.WindowFallback}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type core:Group}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Items.Count, Converter={StaticResource AppsCount}}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type core:LaunchItem}">
            <StackPanel HorizontalAlignment="Center" Margin="4,12,4,4">
                <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" Width="84" Margin="0,8,0,0" FontSize="12" TextAlignment="Center"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PickerTemplate" DataType="{x:Type core:InstalledApp}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Check" Width="20" Height="20" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Brush.ControlStrong}" Background="{DynamicResource Brush.Control}">
                    <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" Style="{StaticResource Text.Glyph}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}" Visibility="Collapsed"/>
                </Border>
                <Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" Margin="14,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Check" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="-20,14,-20,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Divider}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Боковая панель ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Futuretray;component/Assets/logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Futuretray" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="22,12,12,6">
                <TextBlock Text="{ui:T 'Группы'}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Button.Icon}" Content="&#xE710;" HorizontalAlignment="Right" Width="32" Height="32"
                        ToolTip="{ui:T 'Новая группа (Ctrl+N)'}" Click="NewGroup_Click"/>
            </Grid>

            <ListBox x:Name="GroupList" Grid.Row="2" Margin="10,0,10,0" ItemContainerStyle="{StaticResource NavItem}"
                     ItemTemplate="{StaticResource GroupTemplate}" SelectionChanged="GroupList_SelectionChanged"
                     ScrollViewer.CanContentScroll="False"/>

            <StackPanel Grid.Row="3" Margin="10,8,10,14">
                <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="6,0,6,8"/>
                <Button x:Name="SettingsNav" Style="{StaticResource Button.Subtle}" HorizontalContentAlignment="Left"
                        Padding="12,8" ui:Ui.Glyph="&#xE713;" Content="{ui:T 'Настройки'}" Click="Settings_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= Основная область ================= -->
        <Border x:Name="ContentLayer" Grid.Column="1" Margin="0,48,0,0" Background="{DynamicResource Brush.Layer}"
                BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <!-- Редактор группы -->
                <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              AllowDrop="True" DragOver="Editor_DragOver" DragLeave="Editor_DragLeave" Drop="Editor_Drop">
                    <StackPanel x:Name="EditorPanel" Margin="36,28,36,40" MaxWidth="980">

                        <!-- Шапка -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBox x:Name="GroupNameBox" Style="{StaticResource TextBox.Title}" ui:Ui.Placeholder="{ui:T 'Название группы'}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                                <TextBlock Text="{Binding Items.Count, Converter={StaticResource AppsCount}}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Accent}" ui:Ui.Glyph="&#xE718;" Content="{ui:T 'Закрепить на панели задач'}"
                                        Click="Pin_Click" Padding="14,6,16,7"/>
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE768;" Margin="6,0,0,0" ToolTip="{ui:T 'Открыть группу'}" Click="Test_Click"/>
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE712;" ToolTip="{ui:T 'Ещё'}" Click="More_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Приложения -->
                        <Border x:Name="AppsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="{ui:T 'Приложения'}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"/>
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Button.Accent}" ui:Ui.Glyph="&#xE710;" Content="{ui:T 'Добавить приложение'}" Click="AddApp_Click"/>
                                        <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE8E5;" Content="{ui:T 'Файл'}" Margin="6,0,0,0" Click="AddFile_Click"/>
                                        <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE8B7;" Content="{ui:T 'Папка'}" Click="AddFolder_Click"/>
                                        <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE71B;" Content="{ui:T 'Ссылка'}" Click="AddUrl_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                                        Visibility="{Binding SourceFolder, Converter={StaticResource NullCollapsed}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8F7;" Style="{StaticResource Text.Glyph}" Foreground="{DynamicResource Brush.AccentForeground}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{ui:T 'Группа следит за папкой — новые файлы и ярлыки появляются здесь сами'}"/>
                                            <TextBlock Text="{Binding SourceFolder}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Subtle}" Content="{ui:T 'Открыть'}" Click="OpenSourceFolder_Click"/>
                                            <Button Style="{StaticResource Button.Subtle}" Content="{ui:T 'Отвязать'}" Click="UnlinkFolder_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ListBox x:Name="ItemsList" Style="{StaticResource ListBox.Plain}" ItemsSource="{Binding Items}"
                                         ItemContainerStyle="{StaticResource EditorTile}" ItemTemplate="{StaticResource ItemTemplate}"
                                         SelectionChanged="ItemsList_SelectionChanged" KeyDown="ItemsList_KeyDown">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>

                                <Grid x:Name="DropHint" Height="64" Margin="0,4,0,0">
                                    <Rectangle x:Name="DropHintFrame" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                                               Stroke="{DynamicResource Brush.ControlStrong}" Opacity="0.5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Text.Glyph}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="DropHintText" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                                                   Text="{ui:T 'Перетащите сюда программы, ярлыки, папки, файлы или ссылки из браузера'}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="2,10,0,0"
                                           Text="{ui:T 'Порядок меняется перетаскиванием. Delete — удалить выбранное.'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Свойства выбранного приложения -->
                        <Border x:Name="ItemCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Button.Subtle}" Width="76" Height="76" Padding="0" VerticalAlignment="Top"
                                        ToolTip="{ui:T 'Сменить иконку'}" Click="ItemIcon_Click">
                                    <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{ui:T 'Название'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="1" Text="{ui:T 'Расположение'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Target, UpdateSourceTrigger=LostFocus}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="{ui:T 'Обзор…'}" Margin="8,0,0,8" Click="BrowseTarget_Click"
                                                Visibility="{Binding IsPath, Converter={StaticResource BoolVisible}}"/>

                                        <TextBlock Grid.Row="2" Text="{ui:T 'Аргументы'}" Style="{StaticResource FieldLabel}"
                                                   Visibility="{Binding IsPath, Converter={StaticResource BoolVisible}}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" ui:Ui.Placeholder="{ui:T 'Необязательно'}"
                                                 Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsPath, Converter={StaticResource BoolVisible}}"/>

                                        <TextBlock Grid.Row="3" Text="{ui:T 'Рабочая папка'}" Style="{StaticResource FieldLabel}"
                                                   Visibility="{Binding IsPath, Converter={StaticResource BoolVisible}}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" ui:Ui.Placeholder="{ui:T 'По умолчанию — папка программы'}"
                                                 Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsPath, Converter={StaticResource BoolVisible}}"/>

                                        <TextBlock Grid.Row="4" Text="{ui:T 'От имени администратора'}" Style="{StaticResource FieldLabel}"
                                                   Visibility="{Binding IsPath, Converter={StaticResource BoolVisible}}"/>
                                        <CheckBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Toggle}" Margin="0,2,0,6" HorizontalAlignment="Left"
                                                  IsChecked="{Binding RunAsAdmin}" Visibility="{Binding IsPath, Converter={StaticResource BoolVisible}}"/>

                                        <TextBlock Grid.Row="5" Text="{ui:T 'Пауза перед запуском'}" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{ui:T 'При «Открыть все»: сколько подождать после предыдущей программы группы — например, пока подключится VPN'}"/>
                                        <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,6"
                                                    ToolTip="{ui:T 'При «Открыть все»: сколько подождать после предыдущей программы группы — например, пока подключится VPN'}">
                                            <Slider Width="220" Minimum="0" Maximum="60" SmallChange="1" LargeChange="5"
                                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                    Value="{Binding StartDelay, Converter={StaticResource IntDouble}}"/>
                                            <TextBlock Text="{Binding StartDelay, Converter={StaticResource DelayText}}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="-12,10,0,0">
                                        <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE768;" Content="{ui:T 'Запустить'}" Click="RunItem_Click"/>
                                        <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE8B9;" Content="{ui:T 'Сменить иконку'}" Click="ItemIcon_Click"/>
                                        <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE72C;" Content="{ui:T 'Вернуть иконку'}" Click="ResetItemIcon_Click"
                                                Visibility="{Binding CustomIconPath, Converter={StaticResource NullCollapsed}}"/>
                                        <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE838;" Content="{ui:T 'Открыть расположение'}" Click="OpenItemLocation_Click"/>
                                        <Button Style="{StaticResource Button.Danger}" ui:Ui.Glyph="&#xE74D;" Content="{ui:T 'Удалить'}" Click="RemoveItem_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Быстрый доступ -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Сочетание клавиш'}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                   Text="{ui:T 'Открывает группу у курсора из любой программы. Дальше — стрелки, цифры 1–9 или набор названия.'}"/>
                                    </StackPanel>
                                    <ui:HotkeyBox Grid.Column="1" Hotkey="{Binding Hotkey}"/>
                                </Grid>
                                <TextBlock x:Name="GroupHotkeyError" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                           HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Рабочее пространство -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{ui:T 'Рабочее пространство'}" Style="{StaticResource Text.Subtitle}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                           Text="{ui:T 'Расставьте окна программ группы как вам удобно и нажмите «Запомнить расположение». Потом «Разложить» — или «Открыть все» в окне группы — запустит недостающие программы в порядке списка и вернёт окна на свои места. Для каждого набора мониторов расположение запоминается отдельно.'}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource Button.Accent}" ui:Ui.Glyph="&#xE74E;" Content="{ui:T 'Запомнить расположение'}"
                                            Margin="0,0,8,0" Click="CaptureLayout_Click"/>
                                    <Button x:Name="ArrangeButton" ui:Ui.Glyph="&#xE7F4;" Content="{ui:T 'Разложить'}" Margin="0,0,8,0" Click="ArrangeLayout_Click"/>
                                    <Button x:Name="ForgetLayoutButton" Style="{StaticResource Button.Subtle}" Content="{ui:T 'Забыть'}" Click="ForgetLayout_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="LayoutStatus" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <Border Style="{StaticResource RowDivider}" Margin="0,14,0,0"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Открывать при входе в Windows'}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Text="{ui:T 'Группа сама откроется и разложит окна после входа. Паузы между программами задаются в свойствах каждой.'}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding OpenAtLogin}" Click="OpenAtLogin_Click"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" Margin="0,14,0,0"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Другие окна при открытии'}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Text="{ui:T 'Что делать с остальным при «Открыть все»: например, «Работа» сворачивает всё лишнее или закрывает «Отдых».'}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Segments}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Не трогать'}"
                                                         IsChecked="{Binding OthersOnOpen, Converter={StaticResource EnumBool}, ConverterParameter=Keep}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Свернуть'}"
                                                         IsChecked="{Binding OthersOnOpen, Converter={StaticResource EnumBool}, ConverterParameter=Minimize}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Закрыть группы'}"
                                                         IsChecked="{Binding OthersOnOpen, Converter={StaticResource EnumBool}, ConverterParameter=CloseGroups}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding OthersOnOpen, Converter={StaticResource EnumVisible}, ConverterParameter=CloseGroups}">
                                    <TextBlock x:Name="CloseGroupsHint" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel x:Name="CloseGroupsPanel"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                                           Text="{ui:T 'В окне группы: Ctrl+Enter — открыть все, Ctrl+M — свернуть остальное, Ctrl+Shift+W — закрыть все программы группы.'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Внешний вид -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{ui:T 'Внешний вид'}" Style="{StaticResource Text.Subtitle}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Цвет группы'}"/>
                                        <TextBlock Text="{ui:T 'Подложка значка и оттенок всплывающего окна'}" Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <WrapPanel x:Name="SwatchPanel" MaxWidth="440" VerticalAlignment="Center" Margin="0,6,4,0"/>
                                        <TextBox x:Name="HexBox" Width="96" VerticalAlignment="Center" MaxLength="7"
                                                 LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown" ToolTip="{ui:T 'Свой цвет в формате #RRGGBB'}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Значок на панели задач'}"/>
                                        <TextBlock Text="{ui:T '«Авто» собирает значок из первых четырёх приложений'}" Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource Toggle}" Content="{ui:T 'Подложка'}" Margin="0,0,16,0"
                                                  IsChecked="{Binding ShowIconBackground}"/>
                                        <Border Style="{StaticResource Segments}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Авто'}"
                                                             IsChecked="{Binding IconMode, Converter={StaticResource EnumBool}, ConverterParameter=Auto}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Приложение'}"
                                                             IsChecked="{Binding IconMode, Converter={StaticResource EnumBool}, ConverterParameter=Item}"/>
                                                <RadioButton x:Name="CustomIconRadio" Style="{StaticResource Segment}" Content="{ui:T 'Своя картинка'}"
                                                             IsChecked="{Binding IconMode, Converter={StaticResource EnumBool}, ConverterParameter=Custom}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel x:Name="IconChoicePanel" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed"/>
                                <StackPanel x:Name="CustomIconPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="CustomIconName" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="320" TextWrapping="NoWrap"/>
                                    <Button Content="{ui:T 'Выбрать картинку…'}" ui:Ui.Glyph="&#xE8B9;" Click="PickGroupIcon_Click"/>
                                </StackPanel>
                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{ui:T 'Размер значков'}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource Segments}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Маленькие'}"
                                                         IsChecked="{Binding TileSize, Converter={StaticResource EnumBool}, ConverterParameter=Small}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Средние'}"
                                                         IsChecked="{Binding TileSize, Converter={StaticResource EnumBool}, ConverterParameter=Medium}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Крупные'}"
                                                         IsChecked="{Binding TileSize, Converter={StaticResource EnumBool}, ConverterParameter=Large}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{ui:T 'Подписи под значками'}"/>
                                        <TextBlock Text="{ui:T 'Без подписей название видно во всплывающей подсказке'}" Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ShowLabels}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{ui:T 'Колонок в окне'}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="12" SmallChange="1" LargeChange="1"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding Columns, Converter={StaticResource IntDouble}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Columns, Converter={StaticResource ColumnsText}}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Фон окна'}"/>
                                        <TextBlock Text="{ui:T 'Акрил и Mica работают в Windows 11 22H2 и новее'}" Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Segments}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Акрил'}"
                                                         IsChecked="{Binding Backdrop, Converter={StaticResource EnumBool}, ConverterParameter=Acrylic}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="Mica"
                                                         IsChecked="{Binding Backdrop, Converter={StaticResource EnumBool}, ConverterParameter=Mica}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Сплошной'}"
                                                         IsChecked="{Binding Backdrop, Converter={StaticResource EnumBool}, ConverterParameter=Solid}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{ui:T 'Оттенок окна цветом группы'}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                                            Value="{Binding TintOpacity}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TintOpacity, Converter={StaticResource Percent}}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{ui:T 'Закрывать окно после запуска'}"/>
                                        <TextBlock Text="{ui:T 'Ctrl+клик — не закрывать окно группы. Shift+клик или средняя кнопка — открыть ещё одну копию программы'}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding CloseAfterLaunch}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Трей на рабочем столе -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Трей на рабочем столе'}" Style="{StaticResource Text.Subtitle}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                                   Text="{ui:T 'Группа всегда под рукой: отдельная панель у края экрана, без клика по панели задач. Правой кнопкой по трею — быстрые настройки.'}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding DockEnabled}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                </Grid>

                                <StackPanel Visibility="{Binding DockEnabled, Converter={StaticResource BoolVisible}}">
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{ui:T 'Положение'}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Style="{StaticResource Segments}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Слева'}"
                                                             IsChecked="{Binding DockEdge, Converter={StaticResource EnumBool}, ConverterParameter=Left}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Сверху'}"
                                                             IsChecked="{Binding DockEdge, Converter={StaticResource EnumBool}, ConverterParameter=Top}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Справа'}"
                                                             IsChecked="{Binding DockEdge, Converter={StaticResource EnumBool}, ConverterParameter=Right}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Снизу'}"
                                                             IsChecked="{Binding DockEdge, Converter={StaticResource EnumBool}, ConverterParameter=Bottom}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Свободно'}"
                                                             IsChecked="{Binding DockEdge, Converter={StaticResource EnumBool}, ConverterParameter=Free}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" HorizontalAlignment="Right" TextAlignment="Right"
                                               Visibility="{Binding DockEdge, Converter={StaticResource EnumVisible}, ConverterParameter=Free}"
                                               Text="{ui:T 'Перетаскивайте трей за ручку. Отпустите его у края экрана — он прилипнет к этому краю.'}"/>

                                    <StackPanel Visibility="{Binding DockEdge, Converter={StaticResource EnumCollapsed}, ConverterParameter=Free}">
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{ui:T 'Выравнивание вдоль края'}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource Segments}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'В начале'}"
                                                                 IsChecked="{Binding DockAlign, Converter={StaticResource EnumBool}, ConverterParameter=Start}"/>
                                                    <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'По центру'}"
                                                                 IsChecked="{Binding DockAlign, Converter={StaticResource EnumBool}, ConverterParameter=Center}"/>
                                                    <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'В конце'}"
                                                                 IsChecked="{Binding DockAlign, Converter={StaticResource EnumBool}, ConverterParameter=End}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <StackPanel x:Name="DockMonitorRow">
                                            <Border Style="{StaticResource RowDivider}"/>
                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{ui:T 'Монитор'}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource Segments}">
                                                    <StackPanel x:Name="DockMonitorPanel" Orientation="Horizontal"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{ui:T 'Поверх всех окон'}"/>
                                            <TextBlock Style="{StaticResource Text.Caption}"
                                                       Text="{ui:T 'Иначе трей живёт на рабочем столе под окнами и не пропадает по Win+D. В полноэкранных играх и видео трей сам уходит назад.'}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding DockTopmost}"/>
                                    </Grid>

                                    <StackPanel Visibility="{Binding DockEdge, Converter={StaticResource EnumCollapsed}, ConverterParameter=Free}">
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{ui:T 'Прятать за край экрана'}"/>
                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                           Text="{ui:T 'Трей уезжает за край и выезжает, когда вы подводите к нему мышь'}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding DockAutoHide}"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{ui:T 'Резервировать место на экране'}"/>
                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                           Text="{ui:T 'Как панель задач: развёрнутые окна не будут заходить под трей. Не сочетается с автоскрытием.'}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding DockReserveSpace}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Предпросмотр -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{ui:T 'Предпросмотр'}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,14"/>
                                <Grid MinHeight="300" ClipToBounds="True">
                                    <Border CornerRadius="8" Background="{DynamicResource Brush.Wallpaper}"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,24,20,64">
                                        <Border x:Name="PreviewShadow" CornerRadius="8" Background="{DynamicResource Brush.PopupPreview}"
                                                BorderBrush="{DynamicResource Brush.FlyoutStroke}" BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="PreviewTint" CornerRadius="8"/>
                                        <ui:GroupTilesView x:Name="PreviewTiles" Margin="6" IsPreview="True"/>
                                    </Grid>
                                    <Border VerticalAlignment="Bottom" Height="48" CornerRadius="0,0,8,8" Background="{DynamicResource Brush.Taskbar}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <UniformGrid Rows="2" Columns="2" Width="18" Height="18" Margin="11,0">
                                                <Border Background="#FF2D9CDB" Margin="0.75" CornerRadius="1"/>
                                                <Border Background="#FF2D9CDB" Margin="0.75" CornerRadius="1"/>
                                                <Border Background="#FF2D9CDB" Margin="0.75" CornerRadius="1"/>
                                                <Border Background="#FF2D9CDB" Margin="0.75" CornerRadius="1"/>
                                            </UniformGrid>
                                            <Border Width="22" Height="22" CornerRadius="5" Background="#FFF5B841" Margin="9,0" Opacity="0.85"/>
                                            <Border Width="22" Height="22" CornerRadius="11" Background="#FF34A853" Margin="9,0" Opacity="0.85"/>
                                            <Grid Width="40" Height="40" Margin="4,0">
                                                <Border CornerRadius="4" Background="{DynamicResource Brush.SubtleSelected}"/>
                                                <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border Width="16" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                        Background="{DynamicResource Brush.Accent}"/>
                                            </Grid>
                                            <Border Width="22" Height="22" CornerRadius="5" Background="#FF7B61FF" Margin="9,0" Opacity="0.85"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Настройки -->
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="SettingsPanel" Margin="36,28,36,40" MaxWidth="980">
                        <TextBlock Text="{ui:T 'Настройки'}" Style="{StaticResource Text.Title}" Margin="0,0,0,22"/>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{ui:T 'Тема'}"/>
                                    <TextBlock Text="{ui:T '«Системная» следует настройкам Windows: окно редактора — теме приложений, окна групп — теме панели задач'}" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Системная'}"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EnumBool}, ConverterParameter=System}"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Светлая'}"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EnumBool}, ConverterParameter=Light}"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Тёмная'}"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EnumBool}, ConverterParameter=Dark}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{ui:T 'Язык'}"/>
                                    <TextBlock Text="{ui:T 'Язык интерфейса Futuretray. «Как в Windows» — русский для русской Windows, иначе английский.'}" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="{ui:T 'Как в Windows'}"
                                                     IsChecked="{Binding Language, Converter={StaticResource EnumBool}, ConverterParameter=Auto}"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Русский"
                                                     IsChecked="{Binding Language, Converter={StaticResource EnumBool}, ConverterParameter=Russian}"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="English"
                                                     IsChecked="{Binding Language, Converter={StaticResource EnumBool}, ConverterParameter=English}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{ui:T 'Запускать вместе с Windows'}"/>
                                    <TextBlock Text="{ui:T 'Futuretray тихо ждёт в фоне, и группы открываются мгновенно — даже первый раз после включения ПК'}" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding RunAtStartup}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{ui:T 'Значок в области уведомлений'}"/>
                                    <TextBlock Text="{ui:T 'Быстрый доступ к редактору и группам из трея'}" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ShowTrayIcon}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{ui:T 'Переключаться на уже открытую программу'}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{ui:T 'Как на панели задач: клик по запущенной программе показывает её окно, повторный — сворачивает, при нескольких окнах — перебирает их. Чёрточка под значком — программа открыта, длинная — активна. Shift+клик всегда запускает новую копию.'}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding SwitchToRunning}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Поиск по всем группам'}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                   Text="{ui:T 'Сочетание открывает строку поиска: набрали пару букв — Enter. Ещё — в меню значка в трее.'}"/>
                                    </StackPanel>
                                    <ui:HotkeyBox Grid.Column="1" Hotkey="{Binding SearchHotkey}"/>
                                </Grid>
                                <TextBlock x:Name="SearchHotkeyError" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                           HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{ui:T 'Значки сайтов для ссылок'}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{ui:T 'Futuretray один раз заглядывает на сам сайт за его значком и хранит его у вас. Без этого у ссылок значок браузера.'}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding DownloadFavicons}"/>
                            </Grid>
                        </Border>

                        <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{ui:T 'Проверять обновления автоматически'}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                   Text="{ui:T 'Futuretray заглядывает в GitHub Releases пару раз в день и предлагает обновиться в один клик'}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                              IsChecked="{Binding DataContext.CheckUpdates, ElementName=SettingsPanel}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Text.Glyph}" FontSize="14" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource Button.Subtle}" Content="{ui:T 'Что нового'}" Margin="0,0,6,0" Click="ReleaseNotes_Click"
                                                Visibility="{Binding Available, Converter={StaticResource NullCollapsed}}"/>
                                        <Button x:Name="InstallUpdateButton" Style="{StaticResource Button.Accent}" ui:Ui.Glyph="&#xE896;" Margin="0,0,6,0" Click="InstallUpdate_Click"
                                                Content="{Binding Available.Version}"
                                                IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                                                Visibility="{Binding Available, Converter={StaticResource NullCollapsed}}"/>
                                        <Button Content="{ui:T 'Проверить сейчас'}" Click="CheckUpdates_Click"
                                                IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{ui:T 'Что-то работает не так?'}"/>
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{ui:T '«Собрать отчёт» сохранит на рабочий стол zip с журналом ошибок, настройками групп (там видны пути к вашим программам) и сведениями о системе — отправьте его разработчику.'}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button ui:Ui.Glyph="&#xE9D9;" Content="{ui:T 'Собрать отчёт'}" Click="CreateReport_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE939;" Content="{ui:T 'Сообщить о проблеме на GitHub'}" Click="ReportIssue_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{ui:T 'Синхронизация между компьютерами'}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="{ui:T 'Храните группы в папке OneDrive, Dropbox или на сетевом диске — и они будут одинаковыми на всех ваших компьютерах. Расположение окон у каждого набора мониторов своё.'}"/>
                                <TextBlock x:Name="SyncStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="SyncOneDriveButton" Style="{StaticResource Button.Accent}" ui:Ui.Glyph="&#xE753;" Content="{ui:T 'Через OneDrive'}"
                                            Margin="0,0,8,0" Click="SyncOneDrive_Click"/>
                                    <Button x:Name="SyncChooseButton" ui:Ui.Glyph="&#xE8B7;" Content="{ui:T 'Выбрать папку…'}" Margin="0,0,8,0" Click="SyncChoose_Click"/>
                                    <Button x:Name="SyncOpenButton" Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE838;" Content="{ui:T 'Открыть папку'}"
                                            Margin="0,0,8,0" Click="SyncOpen_Click"/>
                                    <Button x:Name="SyncOffButton" Style="{StaticResource Button.Subtle}" Content="{ui:T 'Отключить'}" Click="SyncOff_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="PortableNote" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{ui:T 'Резервная копия'}"/>
                                <TextBlock Text="{ui:T 'Сохраните группы в файл, чтобы перенести их на другой компьютер'}" Style="{StaticResource Text.Caption}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button ui:Ui.Glyph="&#xE898;" Content="{ui:T 'Экспорт групп…'}" Click="Export_Click" Margin="0,0,8,0"/>
                                    <Button ui:Ui.Glyph="&#xE896;" Content="{ui:T 'Импорт групп…'}" Click="Import_Click" Margin="0,0,8,0"/>
                                    <Button ui:Ui.Glyph="&#xE8B5;" Content="{ui:T 'Из Taskbar Groups…'}" Click="ImportTaskbarGroups_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE838;" Content="{ui:T 'Папка с данными'}" Click="OpenDataFolder_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="pack://application:,,,/Futuretray;component/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Futuretray" Style="{StaticResource Text.Strong}"/>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Subtle}" ui:Ui.Glyph="&#xE789;" Content="{ui:T 'Что нового'}" Margin="0,0,8,0"
                                            Click="WhatsNew_Click"/>
                                    <Button Style="{StaticResource Button.Danger}" ui:Ui.Glyph="&#xE7E8;" Content="{ui:T 'Закрыть Futuretray полностью'}"
                                            Click="Exit_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Пустое состояние -->
                <Grid x:Name="EmptyState" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <Image Source="pack://application:,,,/Futuretray;component/Assets/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{ui:T 'Соберите приложения в группы'}" Style="{StaticResource Text.Title}" TextAlignment="Center" Margin="0,24,0,8" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="14" TextAlignment="Center"
                                   Text="{ui:T 'Группа — это один значок на панели задач, который по клику раскрывает набор ваших программ, папок и сайтов.'}"/>
                        <Button Style="{StaticResource Button.Accent}" ui:Ui.Glyph="&#xE710;" Content="{ui:T 'Создать первую группу'}"
                                HorizontalAlignment="Center" Margin="0,24,0,0" Padding="18,8" Click="NewGroup_Click"/>
                        <Button Style="{StaticResource Button.Link}" Content="{ui:T 'Перенести группы из Taskbar Groups'}"
                                HorizontalAlignment="Center" Margin="0,8,0,0" Click="ImportTaskbarGroups_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Кнопки заголовка (если нет Mica — рисуем свои) -->
        <StackPanel x:Name="CaptionButtons" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Visibility="Collapsed">
            <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <!-- ================= Диалоги ================= -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="{DynamicResource Brush.Smoke}" MouseLeftButtonDown="Overlay_BackgroundClick"/>
            <Border x:Name="DialogCard" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    Background="{DynamicResource Brush.Dialog}" BorderBrush="{DynamicResource Brush.FlyoutStroke}" BorderThickness="1" CornerRadius="8"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <Grid>
                    <!-- Закрепление -->
                    <Grid x:Name="PinPanel" Width="560" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="24,22,24,20">
                            <TextBlock Text="{ui:T 'Закрепите группу на панели задач'}" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock x:Name="PinStatus" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                       Text="{ui:T 'Windows не даёт программам закрепляться самостоятельно, поэтому последний шаг — за вами. Это займёт пару секунд.'}"/>

                            <Border Style="{StaticResource Card}" Margin="0,18,0,8" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{ui:T 'Способ 1 — через Проводник'}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource Button.Accent}" ui:Ui.Glyph="&#xE838;" Content="{ui:T 'Показать ярлык'}"
                                                Click="RevealLink_Click"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" LineHeight="18"
                                               Text="{ui:T '1. Нажмите «Показать ярлык» — откроется папка, ярлык группы уже будет выделен.&#x0a;2. Щёлкните по нему правой кнопкой → «Закрепить на панели задач».&#x0a;Если такого пункта нет — выберите «Показать дополнительные параметры» (или Shift + правая кнопка).'}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{ui:T 'Способ 2 — через меню «Пуск»'}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" ui:Ui.Glyph="&#xE80F;" Content="{ui:T 'Добавить в «Пуск»'}" Click="AddToStart_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="StartHint" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" LineHeight="18"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Text.Glyph}" FontSize="14" Foreground="{DynamicResource Brush.AccentForeground}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock Style="{StaticResource Text.Caption}" MaxWidth="480"
                                           Text="{ui:T 'Закрепить нужно один раз: когда вы меняете приложения, название или значок, закреплённая группа обновится сама.'}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource Brush.DialogFooter}" CornerRadius="0,0,8,8" Padding="24,16">
                            <Grid>
                                <StackPanel x:Name="PinWaiting" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="PinWaitingGlyph" Text="&#xE916;" Style="{StaticResource Text.Glyph}" FontSize="14"
                                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="PinWaitingText" Text="{ui:T 'Жду, пока значок появится на панели задач…'}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource Button.Accent}" Content="{ui:T 'Готово'}" MinWidth="120" Click="CloseOverlay_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Выбор приложений -->
                    <Grid x:Name="PickerPanel" Width="600" Height="640" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="24,22,24,12">
                            <TextBlock Text="{ui:T 'Добавить приложения'}" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock Text="{ui:T 'Всё из меню «Пуск», включая приложения Microsoft Store. Можно выбрать несколько.'}" Style="{StaticResource Text.Caption}" Margin="0,4,0,14"/>
                            <TextBox x:Name="PickerSearch" ui:Ui.Placeholder="{ui:T 'Поиск приложений'}" TextChanged="PickerSearch_TextChanged" KeyDown="PickerSearch_KeyDown"/>
                        </StackPanel>
                        <ListBox x:Name="PickerList" Grid.Row="1" Margin="14,0,14,8" SelectionMode="Multiple"
                                 ItemContainerStyle="{StaticResource PickerItem}" ItemTemplate="{StaticResource PickerTemplate}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="PickerList_DoubleClick"/>
                        <TextBlock x:Name="PickerLoading" Grid.Row="1" Text="{ui:T 'Собираю список приложений…'}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Visibility="Collapsed"/>
                        <Border Grid.Row="2" Background="{DynamicResource Brush.DialogFooter}" CornerRadius="0,0,8,8" Padding="24,16">
                            <Grid>
                                <TextBlock x:Name="PickerCount" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{ui:T 'Отмена'}" MinWidth="110" Click="CloseOverlay_Click"/>
                                    <Button x:Name="PickerAddButton" Style="{StaticResource Button.Accent}" Content="{ui:T 'Добавить'}" MinWidth="110" Margin="8,0,0,0" Click="PickerAdd_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- В папке синхронизации уже есть группы -->
                    <Grid x:Name="SyncChoicePanel" Width="500" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="24,22,24,22">
                            <TextBlock Text="{ui:T 'В этой папке уже есть группы'}" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{ui:T 'Скорее всего, их сохранил Futuretray на другом компьютере. Взять их — группы этого компьютера заменятся ими (Futuretray перезапустится). Заменить — в папку запишутся группы этого компьютера.'}"/>
                            <TextBlock x:Name="SyncChoiceFolder" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource Brush.DialogFooter}" CornerRadius="0,0,8,8" Padding="24,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{ui:T 'Отмена'}" MinWidth="96" Click="CloseOverlay_Click"/>
                                <Button Content="{ui:T 'Заменить моими'}" MinWidth="96" Margin="8,0,0,0" Click="SyncReplace_Click"/>
                                <Button Style="{StaticResource Button.Accent}" Content="{ui:T 'Взять из папки'}" MinWidth="96" Margin="8,0,0,0" Click="SyncUseExisting_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Что нового -->
                    <Grid x:Name="WhatsNewPanel" Width="560" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="24,22,12,16">
                            <TextBlock x:Name="WhatsNewTitle" Style="{StaticResource Text.Subtitle}" Margin="0,0,12,0"/>
                            <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="0,0,12,0">
                                <StackPanel x:Name="WhatsNewBody"/>
                            </ScrollViewer>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource Brush.DialogFooter}" CornerRadius="0,0,8,8" Padding="24,16">
                            <Grid>
                                <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left" Content="{ui:T 'Все изменения'}" Click="AllChanges_Click"/>
                                <Button Style="{StaticResource Button.Accent}" HorizontalAlignment="Right" Content="{ui:T 'Понятно'}" MinWidth="110" Click="CloseOverlay_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Ссылка -->
                    <Grid x:Name="UrlPanel" Width="480" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="24,22,24,22">
                            <TextBlock Text="{ui:T 'Добавить ссылку'}" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock Text="{ui:T 'Сайт откроется в браузере по умолчанию. Подойдут и ссылки вида steam://, discord://, tg://'}" Style="{StaticResource Text.Caption}" Margin="0,4,0,16"/>
                            <TextBox x:Name="UrlBox" ui:Ui.Placeholder="https://example.com" KeyDown="UrlBox_KeyDown"/>
                            <TextBox x:Name="UrlNameBox" ui:Ui.Placeholder="{ui:T 'Название (необязательно)'}" Margin="0,8,0,0" KeyDown="UrlBox_KeyDown"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource Brush.DialogFooter}" CornerRadius="0,0,8,8" Padding="24,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{ui:T 'Отмена'}" MinWidth="110" Click="CloseOverlay_Click"/>
                                <Button Style="{StaticResource Button.Accent}" Content="{ui:T 'Добавить'}" MinWidth="110" Margin="8,0,0,0" Click="UrlAdd_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Уведомление с «Отменить» -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{DynamicResource Brush.Flyout}" BorderBrush="{DynamicResource Brush.FlyoutStroke}" BorderThickness="1"
                CornerRadius="8" Padding="16,6,6,6" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" MaxWidth="520" TextWrapping="Wrap"/>
                <Button x:Name="ToastAction" Style="{StaticResource Button.Link}" Margin="12,0,0,0" Click="ToastAction_Click"/>
                <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="11" Width="30" Height="30" Margin="4,0,0,0" Click="ToastClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
